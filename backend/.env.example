# ============================================================================
# Dev House Backend & MCP Server Configuration (.env.example)
# ============================================================================
NODE_ENV=production
PORT=4000
WORKSPACE_DEFAULT_TIMEZONE=Asia/Kolkata

# Database & Queue
DATABASE_URL=postgresql://devhouse:devhouse_secret_pw@localhost:5432/devhouse
REDIS_URL=redis://localhost:6379

# AES-256-GCM Secret Vault Master Key (64 hex chars = 32 bytes)
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_COOKIE_SECRET=devhouse_session_hmac_secret_change_in_prod_994201

# S3 / Cloudflare R2 / MinIO Object Storage
S3_ENDPOINT=https://88a1.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=devhouse-prod
S3_ACCESS_KEY_ID=replace_with_r2_access_key
S3_SECRET_ACCESS_KEY=replace_with_r2_secret_key

# LLM execution mode ('mock' forces deterministic synthesized completions even with real BYOK keys)
LLM_MODE=live

# Social Connector Mode ('mock' runs full pipeline without real accounts; 'live' calls YouTube/LinkedIn/IG APIs)
CONNECTOR_MODE=mock

# Live publishing identities (required only when CONNECTOR_MODE=live)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_AUTHOR_URN=

# OAuth Credentials (Required only when CONNECTOR_MODE=live)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Outbound Notifiers & Webhooks
WEBHOOK_SIGNING_SECRET=whsec_devhouse_hmac_sha256_key
# Destination URL that receives the signed X-DevHouse-Signature-256 payload
OUTBOUND_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_URL=
