{
  "name": "dev-house-backend-monorepo",
  "version": "2.4.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @devhouse/db migrate",
    "db:seed": "pnpm --filter @devhouse/db seed",
    "mcp:stdio": "pnpm --filter @devhouse/mcp stdio"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
